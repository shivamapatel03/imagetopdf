# ImageToPDF.online Environment Variables
# Copy to .env.local and update values

# NEXT PUBLIC SITE URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SUPABASE CONFIGURATION
# Find these in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# GOOGLE ADSENSE CONFIGURATION (100% Free Ad-Supported SaaS)
# Set your Google AdSense Publisher Client ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=
NEXT_PUBLIC_ADSENSE_SLOT_STUDIO=

# OPTIONAL / LEGACY PAYMENT CONFIGURATION (Site is now 100% free)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
